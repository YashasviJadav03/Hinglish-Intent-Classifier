# Large Model weights and raw data caches
# Keep the best LoRA adapter (small ~3.5MB) for deployment
models/*
!models/lora-adapter/
models/lora-adapter/lora_r*/
models/lora-adapter/phase3*/

# Raw data (regeneratable)
data/raw/*
!data/raw/.gitkeep

# Keep processed data (small CSVs needed at inference time for label mappings)
!data/processed/

# Results / Artifacts (keep structure, ignore large temp artifacts)
results/runs/
*.log
